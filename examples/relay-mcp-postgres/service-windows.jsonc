// service-windows.jsonc - Configuration for running relay-mcp-postgres as a Windows background task / service
// Install (no admin needed): tailsacle-cli service install --file service-windows.jsonc --scheduler --yes
// Install (as Windows SCM service): tailsacle-cli service install --file service-windows.jsonc --yes
{
  "name": "tailscale-postgres-relay",
  "description": "Tailscale PostgreSQL Relay and NexQL HTTP MCP Server",
  "workingDir": "C:\\tailsacle-relay",
  "args": [
    "relay-mcp-postgres",
    "--file", "C:\\tailsacle-relay\\multi-db.jsonc",
    "--mcp-port", "8787",
    "--mcp-bind", "0.0.0.0",
    "--allow-partial",
    "--primary-fallback",
    "--db-retry-interval", "5000"
  ],
  "env": {
    "NEXQL_MCP_HTTP_TOKEN": "replace-with-your-secure-mcp-token"
  },
  "restart": {
    "policy": "always",
    "delaySeconds": 5
  },
  "log": {
    "dir": "C:\\ProgramData\\tailsacle-cli\\logs\\postgres-relay",
    "maxSizeMb": 10,
    "keepFiles": 5
  }
}
